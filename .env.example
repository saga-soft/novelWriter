# Copy to .env and fill in for dev tooling

# Crowdin Personal Access Token scoped to at least `project.report` (Read only)
# Needed for `qtlimport --credits-since`
CROWDIN_REPORT_READ_TOKEN=

# Path for long-term cached files, like downloaded icon packs
# Used by `icons` unless `--work-dir` is set
CACHE_DIR=
